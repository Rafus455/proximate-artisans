{% extends 'base.html.twig' %}
{% block title %}SC3D — Stop0Guêpes | Dératisation, désinsectisation, désinfection{% endblock %}
{% block meta_description %}SC3D Stop0Guêpes, spécialiste de l'hygiène 3D dans le Loiret, le Cher, le Loir-et-Cher et l'Indre-et-Loire : dératisation, désinsectisation, désinfection.{% endblock %}

{% block body %}
<div class="profile-header">
    <div class="profile-header__avatar">S</div>
    <div class="profile-header__meta">
        <h1>SC3D — Stop0Guêpes</h1>
        <p style="color: var(--ink-soft); font-size: 15px; margin-top: 6px;">Spécialisé dans l'hygiène 3D — Dératisation, désinsectisation, désinfection</p>
        <div class="profile-header__tags" style="margin-top: 14px;">
            <span class="tag">Dératisation</span>
            <span class="tag">Désinsectisation</span>
            <span class="tag">Désinfection</span>
        </div>
    </div>
</div>

<<div class="container profile-content">

    <section class="panel">
        <h2>Description</h2>
        <p style="color: var(--ink-soft); font-size: 14.5px; line-height: 1.9;">
            SC3D Stop0Guêpes est une société spécialisée dans l'hygiène 3D : dératisation,
            désinsectisation et désinfection. Nous intervenons dans le Loiret, le Cher,
            le Loir-et-Cher et l'Indre-et-Loire, avec des déplacements plus éloignés possibles
            sur demande.
        </p>
        <p style="color: var(--ink-soft); font-size: 14.5px; line-height: 1.9; margin-top: 14px;">
            Notre expertise couvre la désinsectisation (puces, blattes, punaises de lit,
            chenilles processionnaires), la destruction de nids de guêpes et de frelons,
            le dépigeonnage, ainsi que la dératisation et la lutte contre tous types de
            nuisibles. Nous sommes piégeur agréé des ESOD (espèces susceptibles d'occasionner
            des dégâts) et intervenons également sur le traitement des logements touchés par
            le syndrome de Diogène.
        </p>
        <p style="color: var(--ink-soft); font-size: 14.5px; line-height: 1.9; margin-top: 14px;">
            Nous accompagnons aussi bien les particuliers que les professionnels et les
            collectivités : boulangeries, boucheries, hôtels, restaurants, sociétés de
            transport et logistique, fermes agricoles, élevages de poulets labellisés,
            meuniers, hôpitaux et cuisines centrales, centres médico-psychologiques,
            administration pénitentiaire, musées, mairies, bibliothèques, établissements
            scolaires, centres animaliers, silos agricoles, entreprises, maisons et
            appartements.
        </p>
        <p style="color: var(--ink-soft); font-size: 14.5px; line-height: 1.9; margin-top: 14px;">
            Au-delà de l'intervention, nous proposons un véritable accompagnement en
            conseil et expertise : prévention, traitement curatif, élaboration de solutions
            adaptées à chaque situation. Notre méthodologie repose sur la réalisation de
            diagnostics, l'élaboration de plans de désinsectisation et de dératisation, la
            mise en place de programmes de lutte contre les nuisibles, et un suivi des
            interventions accompagné de conseils de prévention.
        </p>
        <p style="color: var(--ink-soft); font-size: 14.5px; line-height: 1.9; margin-top: 14px;">
            Notre démarche s'appuie sur l'utilisation de produits biocides conformes à la
            réglementation, choisis en fonction de l'hygiène, de la sécurité, de
            l'environnement et du bien-être animal — dans le respect de la faune et de la
            flore, avec la recherche de solutions efficaces à impact environnemental
            maîtrisé.
        </p>
    </section>

    <section class="panel">
        <h2>Zone d'intervention</h2>

    <section class="panel">
        <h2>Lieux d'intervention</h2>
        <p style="color: var(--ink-soft); font-size: 14.5px; line-height: 1.8;">
            Boulangeries · Boucheries · Hôtels · Restaurants · Sociétés de transport et logistique ·
            Fermes agricoles · Élevages de poulets labellisés · Meuniers · Hôpitaux et cuisines centrales
            d'hôpitaux · Centres médico-psychologiques · Administration pénitentiaire · Particuliers ·
            Musées · Mairies · Bibliothèques · Établissements scolaires · Centres animaliers ·
            Silos agricoles · Entreprises · Maisons · Appartements
        </p>
    </section>

    <section class="panel">
        <h2>Services</h2>
        <div class="reviews-grid">
            <div class="review-card">
                <p class="review-card__name">Désinsectisation</p>
                <p class="review-card__comment">Puces, blattes (cafards), punaises de lit, chenilles processionnaires...</p>
            </div>
            <div class="review-card">
                <p class="review-card__name">Nids de guêpes & frelons</p>
                <p class="review-card__comment">Destruction de nids en hauteur ou au sol.</p>
            </div>
            <div class="review-card">
                <p class="review-card__name">Dépigeonnage</p>
                <p class="review-card__comment">Solutions adaptées pour limiter la présence de pigeons.</p>
            </div>
            <div class="review-card">
                <p class="review-card__name">Dératisation</p>
                <p class="review-card__comment">Lutte contre tous types de nuisibles, y compris en faux plafonds.</p>
            </div>
            <div class="review-card">
                <p class="review-card__name">Piégeage ESOD</p>
                <p class="review-card__comment">Piégeur agréé pour les espèces susceptibles d'occasionner des dégâts.</p>
            </div>
            <div class="review-card">
                <p class="review-card__name">Syndrome de Diogène</p>
                <p class="review-card__comment">Traitement des logements touchés.</p>
            </div>
        </div>
    </section>

    <section class="panel">
        <h2>Conseil & expertise</h2>
        <p style="color: var(--ink-soft); font-size: 14.5px; line-height: 1.8;">
            Société spécialisée dans le conseil en hygiène, avec un accompagnement en prévention et en
            traitement curatif. Élaboration de solutions adaptées à chaque situation, pour les
            particuliers, les professionnels et les collectivités.
        </p>
    </section>

    <section class="panel">
        <h2>Méthodologie</h2>
        <div class="steps-grid" style="color: var(--ink);">
            <div class="step" style="border-left-color: var(--line);">
                <div class="step__index" style="color: var(--ochre);">01</div>
                <h3 style="color: var(--ink); font-size: 17px;">Diagnostic</h3>
                <p style="color: var(--ink-soft);">Réalisation d'un diagnostic complet de la situation.</p>
            </div>
            <div class="step" style="border-left-color: var(--line);">
                <div class="step__index" style="color: var(--ochre);">02</div>
                <h3 style="color: var(--ink); font-size: 17px;">Plan d'action</h3>
                <p style="color: var(--ink-soft);">Élaboration d'un plan de désinsectisation et de dératisation.</p>
            </div>
            <div class="step" style="border-left-color: var(--line);">
                <div class="step__index" style="color: var(--ochre);">03</div>
                <h3 style="color: var(--ink); font-size: 17px;">Traitement</h3>
                <p style="color: var(--ink-soft);">Mise en place du programme de lutte contre les nuisibles.</p>
            </div>
            <div class="step" style="border-left-color: var(--line);">
                <div class="step__index" style="color: var(--ochre);">04</div>
                <h3 style="color: var(--ink); font-size: 17px;">Suivi</h3>
                <p style="color: var(--ink-soft);">Suivi des interventions et conseils de prévention.</p>
            </div>
        </div>
    </section>

    <section class="panel">
        <h2>Environnement & sécurité</h2>
        <p style="color: var(--ink-soft); font-size: 14.5px; line-height: 1.8;">
            Utilisation de produits biocides conformes à la réglementation. Choix des produits en
            fonction de l'hygiène, de la sécurité, de l'environnement et du bien-être animal.
            Respect de la faune et de la flore, avec la recherche de solutions efficaces à impact
            environnemental maîtrisé.
        </p>
    </section>

    <section class="panel panel--contact">
        <h2>Coordonnées</h2>
        <p style="color: var(--ink-soft); font-size: 14.5px; line-height: 2;">
            <strong style="color: var(--ink);">Téléphone :</strong> 06 28 42 26 44 — 06 16 28 44 36<br>
            <strong style="color: var(--ink);">Email :</strong> cormiersebastien@neuf.fr<br>
            <strong style="color: var(--ink);">Instagram :</strong> stopoguepes<br>
            <strong style="color: var(--ink);">Facebook :</strong> Stop0guepes
        </p>

        <h2 style="margin-top: 32px;">Envoyer un message</h2>
        <form action="#" method="post" class="contact-form">
            <label for="name">Nom</label>
            <input type="text" id="name" name="name" required>

            <label for="email">Email</label>
            <input type="email" id="email" name="email" required>

            <label for="message">Message</label>
            <textarea id="message" name="message" required placeholder="Décrivez votre besoin..."></textarea>

            <button type="submit" class="btn btn--primary">Envoyer le message</button>
        </form>
    </section>

</div>
{% endblock %}
