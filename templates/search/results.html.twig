{% extends 'base.html.twig' %}
{% block title %}Résultats de recherche — Ouvrage{% endblock %}
{% block meta_description %}Trouvez l'artisan qu'il vous faut près de chez vous.{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="/vendor/leaflet/leaflet.css"/>
{% endblock %}

{% block body %}
    <div class="container">
        <div class="search-header">
            <h1>Résultats de recherche</h1>
            <p>
                <strong>{{ artisans|length }} artisan{{ artisans|length > 1 ? 's' : '' }}</strong>
                trouvé{{ artisans|length > 1 ? 's' : '' }} pour « {{ search_query|default('votre recherche') }} »
            </p>
        </div>

        <div class="results-layout results-layout--with-map">
            <div class="filter-sidebar">
                <h2>Filtrer</h2>
                <form>
                    <label for="metier">Métier</label>
                    <input type="text" id="metier" name="metier" placeholder="Tous les métiers">

                    <label for="distance">Distance (km)</label>
                    <input type="number" id="distance" name="distance" placeholder="20">
                </form>
            </div>

            <div class="card-grid card-grid--with-map">
                {% for artisan in artisans %}
    <div class="card">
        <img src="{{ artisan.url_photo_placeholder }}" alt="{{ artisan.nom }}">
        <h3>{{ artisan.nom }}</h3>
        <p>{{ artisan.metier }} · {{ artisan.ville }}</p>
        {% if artisan.nom == 'Martin Dubois' %}
            <a href="{{ path('app_entreprise_sc3d') }}" class="btn btn--primary">Voir le profil</a>
        {% else %}
            <a href="{{ path('app_artisan_profile', { id: artisan.id }) }}" class="btn btn--primary">Voir le profil</a>
        {% endif %}
    </div>
{% endfor %}
            </div>

            <div class="map-panel">
                <div id="map"></div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="/vendor/leaflet/leaflet.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const artisans = {{ artisans|json_encode|raw }};
            const mapEl = document.getElementById('map');
            if (!mapEl) return;

            const map = L.map('map').setView([47.9029, 1.9093], 11);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap contributors',
                maxZoom: 18
            }).addTo(map);

            artisans.forEach(function (artisan) {
                if (artisan.lat && artisan.lng) {
                    L.marker([artisan.lat, artisan.lng])
                        .addTo(map)
                        .bindPopup('<strong>' + artisan.nom + '</strong><br>' + artisan.metier + ' — ' + artisan.ville);
                }
            });
        });
    </script>
{% endblock %}
