{% extends 'base.html.twig' %}

{% block title %}Recherche Résultats{% endblock %}

{% block body %}
    <div class="search-header">
        <h1>Résultats de la recherche</h1>
        <p>Vous avez recherché : {{ search_query }}</p>
    </div>

    <div class="filter-sidebar">
        <h2>Filtrer</h2>
        <form>
            <label for="metier">Métier:</label>
            <input type="text" id="metier" name="metier"><br><br>
            
            <label for="distance">Distance (km):</label>
            <input type="number" id="distance" name="distance"><br><br>
            
            <label for="note_min">Note minimum:</label>
            <input type="number" id="note_min" name="note_min" min="1" max="5"><br><br>
        </form>
    </div>

    <div class="card-grid">
        {% for artisan in artisans %}
            <div class="card">
                <img src="{{ artisan.url_photo_placeholder }}" alt="{{ artisan.nom }}">
                <h3>{{ artisan.nom }}</h3>
                <p>Métier : {{ artisan.metier }}</p>
                <p>Ville : {{ artisan.ville }}</p>
                <p>Note : {% for i in range(artisan.note|round) %}★{% endfor %}</p>
                <p>Tarif Indicatif : {{ artisan.tarif_indicatif }} €</p>
                <a href="{{ path('app_artisan_profile', { 'id': artisan.id }) }}" class="btn">Voir le profil</a>
            </div>
        {% endfor %}
    </div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="/assets/styles/app.css">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}
