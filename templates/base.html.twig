<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Ouvrage — Trouvez un artisan près de chez vous{% endblock %}</title>
    <meta name="description" content="{% block meta_description %}Menuisier, jardinier, plombier... trouvez et contactez un artisan vérifié proche de chez vous.{% endblock %}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    {% endblock %}
</head>
<body>

<header class="site-header">
    <div class="container site-header__bar">
        <a href="{{ path('app_home') }}" class="brand">
            <svg class="brand__mark" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M4 24V11L14 4L24 11V24H17V16H11V24H4Z" stroke="#2F4A3D" stroke-width="2" stroke-linejoin="round"/>
            </svg>
            Ouvrage
        </a>

        <nav class="nav">
            <ul class="nav-list">
                <li><a href="#">Accueil</a></li>
                <li><a href="{{ path('app_search') }}">Rechercher un artisan</a></li>
                <li><a href="{{ path('app_become_artisan') }}">Devenir artisan</a></li>
                <li><a href="{{ path('app_login') }}">Connexion</a></li>
            </ul>
        </nav>

        <div class="hamburger-menu">
            <button class="hamburger" type="button">
                <span class="bar"></span>
                <span class="bar"></span>
                <span class="bar"></span>
            </button>
        </div>
    </div>
</header>

<main>
    {% block body %}{% endblock %}
</main>

<footer class="site-footer">
    <div class="container site-footer__row">
        <small>© {{ "now"|date("Y") }} Ouvrage — Fleury-lès-Aubrais</small>
        <nav>
            <a href="#">Mentions légales</a>
            <a href="#">Confidentialité (RGPD)</a>
            <a href="#">Contact</a>
            <a href="#">Facebook</a>
            <a href="#">Twitter</a>
        </nav>
    </div>
</footer>

<script>
document.querySelector('.hamburger').addEventListener('click', function() {
    document.querySelector('.nav-list').classList.toggle('active');
});
</script>

<style>
.site-header__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.nav-list {
    list-style-type: none;
    padding: 0;
    margin: 0;
    display: flex;
}

.nav-list li a {
    text-decoration: none;
    color: var(--primary-color);
    padding: 1rem;
}

.hamburger-menu {
    display: none;
}

.hamburger {
    background: none;
    border: none;
    cursor: pointer;
}

.bar {
    width: 25px;
    height: 3px;
    background-color: #007bff;
    margin: 4px 0;
    transition: transform 0.3s ease-in-out;
}

.hamburger.active .bar:nth-child(1) {
    transform: translateY(8px) rotate(-45deg);
}

.hamburger.active .bar:nth-child(2) {
    opacity: 0;
}

.hamburger.active .bar:nth-child(3) {
    transform: translateY(-8px) rotate(45deg);
}

@media (max-width: 768px) {
    .nav-list {
        display: none;
        flex-direction: column;
        width: 100%;
        background-color: var(--neutral-color);
        position: absolute;
        top: 60px;
        left: 0;
        right: 0;
        z-index: 1000;
    }

    .nav-list.active {
        display: flex;
    }

    .hamburger-menu {
        display: block;
    }
}
</style>
<script>
    window.addEventListener('scroll', function () {
        document.querySelector('.site-header').classList.toggle('is-scrolled', window.scrollY > 8);
    });
</script>

<script>
    document.querySelectorAll('.carousel').forEach(function (carousel) {
        const track = carousel.querySelector('.carousel__track');
        const prev = carousel.querySelector('.carousel__arrow--prev');
        const next = carousel.querySelector('.carousel__arrow--next');
        const scrollAmount = 340;

        if (prev) prev.addEventListener('click', () => track.scrollBy({ left: -scrollAmount, behavior: 'smooth' }));
        if (next) next.addEventListener('click', () => track.scrollBy({ left: scrollAmount, behavior: 'smooth' }));
    });
</script>
</body>
</html>
