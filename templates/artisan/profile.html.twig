{% extends 'base.html.twig' %}
{% block title %}{{ artisan.nom_entreprise }} — Ouvrage{% endblock %}
{% block meta_description %}Découvrez le profil complet de {{ artisan.nom_entreprise }}, {{ artisan.metier|lower }} sur Ouvrage.{% endblock %}

{% block body %}
<div class="profile-header">
    <div class="profile-header__avatar">{{ artisan.nom_entreprise|slice(0, 1) }}</div>
    <div class="profile-header__meta">
        <h1>{{ artisan.nom_entreprise }}</h1>
        <div class="profile-header__tags">
            <span class="tag">{{ artisan.metier }}</span>
            <span class="tag">{{ artisan.ville }}</span>
        </div>
    </div>
</div>

<div class="container profile-content">
    <section class="panel">
        <h2>Description</h2>
        <p>{{ artisan.description }}</p>
    </section>

    <section class="panel">
        <h2>Disponibilités</h2>
        <table class="availability-table">
            {% for day, hours in artisan.disponibilites %}
                <tr>
                    <td>{{ day }}</td>
                    <td>{{ hours }}</td>
                </tr>
            {% endfor %}
        </table>
    </section>

    <section class="panel panel--contact">
        <h2>Contacter {{ artisan.nom_entreprise }}</h2>
        <form action="#" method="post" class="contact-form">
            <label for="name">Nom</label>
            <input type="text" id="name" name="name" required>

            <label for="email">Email</label>
            <input type="email" id="email" name="email" required>

            <label for="message">Message</label>
            <textarea id="message" name="message" required placeholder="Décrivez votre besoin en quelques mots..."></textarea>

            <button type="submit" class="btn btn--primary">Envoyer le message</button>
        </form>
    </section>
</div>
{% endblock %}
