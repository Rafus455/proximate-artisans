{% extends 'base.html.twig' %}

{% block title %}Profil de l'artisan - {{ artisan.nom_entreprise }}{% endblock %}
{% block meta_description %}Découvrez le profil complet de l'artisan {{ artisan.nom_entreprise }}.{% endblock %}

{% block body %}
<div class="profile-page">
    <div class="profile-header">
        <div class="profile-header__avatar">{{ artisan.nom_entreprise|slice(0, 1) }}</div>
        <div class="profile-header__meta">
            <h1>{{ artisan.nom_entreprise }}</h1>
            <div class="profile-header__tags">
                <span class="tag">{{ artisan.metier }}</span>
                <span class="tag">{{ artisan.ville }}</span>
                <span class="tag tag--rate">{{ artisan.tarif_indicatif }}</span>
            </div>
            <p class="profile-header__stars"><span class="stars">{% for _ in range(1, artisan.note|round) %}★{% endfor %}</span> <span class="profile-header__note-value">{{ artisan.note }}/5</span></p>
        </div>
    </div>

    <div class="container profile-content">
        <section class="panel">
            <h2>Description</h2>
            <p>{{ artisan.description }}</p>
        </section>

        <section class="panel">
            <h2>Disponibilités</h2>
            <table class="availability-table">
                {% for day, hours in artisan.disponibilites %}
                    <tr>
                        <td>{{ day }}</td>
                        <td>{{ hours }}</td>
                    </tr>
                {% endfor %}
            </table>
        </section>

        <section class="panel">
            <h2>Avis clients</h2>
            <div class="reviews-grid">
                {% for review in artisan.avis %}
                    <div class="review-card">
                        <div class="review-card__head">
                            <div class="review-card__avatar">{{ review.nom_client|slice(0, 1) }}</div>
                            <div>
                                <p class="review-card__name">{{ review.nom_client }}</p>
                                <span class="stars">{% for _ in range(1, review.note|round) %}★{% endfor %}</span>
                            </div>
                        </div>
                        <p class="review-card__comment">{{ review.commentaire }}</p>
                    </div>
                {% endfor %}
            </div>
        </section>

        <section class="panel panel--contact">
            <h2>Contactez {{ artisan.nom_entreprise }}</h2>
            <form action="#" method="post" class="contact-form">
                <label for="name">Nom</label>
                <input type="text" id="name" name="name" required>
                <label for="email">Email</label>
                <input type="email" id="email" name="email" required>
                <label for="message">Message</label>
                <textarea id="message" name="message" required></textarea>
                <button type="submit" class="btn btn--primary">Envoyer le message</button>
            </form>
        </section>
    </div>
</div>
{% endblock %}
