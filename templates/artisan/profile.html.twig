{% extends 'base.html.twig' %}

{% block title %}Profil de l'artisan - {{ artisan.nom_entreprise }}{% endblock %}
{% block meta_description %}Découvrez le profil complet de l'artisan {{ artisan.nom_entreprise }}.{% endblock %}

{% block body %}
<div class="container">
    <div class="search-header">
        <h1>{{ artisan.nom_entreprise }}</h1>
        <p><strong>Métier:</strong> {{ artisan.metier }}</p>
        <p><strong>Ville:</strong> {{ artisan.ville }}</p>
        <p><strong>Note:</strong> {% for _ in range(artisan.note|round) %}★{% endfor %}</p>
    </div>

    <section class="section">
        <h2>Description</h2>
        <p>{{ artisan.description }}</p>
    </section>

    <section class="section">
        <h2>Disponibilités</h2>
        <table class="card-grid">
            {% for day, hours in artisan.disponibilites %}
                <tr>
                    <td>{{ day }}</td>
                    <td>{{ hours }}</td>
                </tr>
            {% endfor %}
        </table>
    </section>

    <section class="section">
        <h2>Avis clients</h2>
        {% for review in artisan.avis %}
            <div class="card">
                <p><strong>Nom:</strong> {{ review.nom_client }}</p>
                <p><strong>Note:</strong> {% for _ in range(review.note|round) %}★{% endfor %}</p>
                <p><strong>Commentaire:</strong> {{ review.commentaire }}</p>
            </div>
        {% endfor %}
    </section>

    <section class="section">
        <h2>Contactez-nous</h2>
        <form action="#" method="post" class="card">
            <label for="name">Nom:</label>
            <input type="text" id="name" name="name" required>

            <label for="email">Email:</label>
            <input type="email" id="email" name="email" required>

            <label for="message">Message:</label>
            <textarea id="message" name="message" required></textarea>

            <button type="submit" class="btn">Envoyer</button>
        </form>
    </section>
</div>
{% endblock %}
