{% extends 'base.html.twig' %}

{% block title %}Connexion - Ouvrage{% endblock %}
{% block meta_description %}Connectez-vous à votre compte ou créez un nouveau compte pour accéder aux services d'Ouvrage.{% endblock %}

{% block body %}
<div class="login-card">
    <a href="{{ path('app_home') }}" class="brand">
        <svg class="brand__mark" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M4 24V11L14 4L24 11V24H17V16H11V24H4Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
        </svg>
        Ouvrage
    </a>

    <div class="login-form">
        <h2>Connexion</h2>

        <form action="#" method="post">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required>

            <label for="password">Mot de passe</label>
            <input type="password" id="password" name="password" required>

            <label class="login-form__checkbox">
                <input type="checkbox" name="remember_me"> Se souvenir de moi
            </label>

            <button type="submit" class="btn btn--primary">Se connecter</button>
        </form>

        <p class="login-form__links"><a href="#">Mot de passe oublié ?</a></p>
        <p class="login-form__links">Pas encore de compte ? <a href="#">Créer un compte artisan ou client</a></p>
    </div>
</div>
{% endblock %}

